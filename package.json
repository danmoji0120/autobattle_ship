{
  "name": "siderarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "다중 계층 지휘형 우주 함대 오토배틀러",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "vite-node scripts/balance.ts",
    "playtest": "node scripts/uitest.mjs",
    "shots": "node scripts/shot.mjs",
    "build:server": "esbuild src/server/node.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "worldbot": "vite-node scripts/worldbot.ts",
    "content:check": "vite-node scripts/content-check.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/rajdhani": "^5.3.0",
    "pg": "^8.16.3",
    "three": "^0.187.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-node": "^5.2.0",
    "vitest": "^4.0.18"
  }
}